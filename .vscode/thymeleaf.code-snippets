{
  "th:text": {
    "scope": "html",
    "prefix": "thtxt",
    "body": "th:text=\"\\${$1}\"",
    "description": "Thymeleaf text",
  },
  "th:field": {
    "scope": "html",
    "prefix": "thfld",
    "body": "th:field=\"*{${1}}\"",
    "description": "Thymeleaf field",
  },
  "th:each": {
    "scope": "html",
    "prefix": "theach",
    "body": "th:each=\"${1:item} : \\${$2}\"",
    "description": "Thymeleaf each",
  },
  "th:each li": {
    "scope": "html",
    "prefix": "theachli",
    "body": "<li th:each=\"${1:item} : \\${$2}\"></li>",
    "description": "Thymeleaf each list",
  },
  "th:object": {
    "scope": "html",
    "prefix": "thobj",
    "body": "th:object=\"\\${$1}\"",
    "description": "Thymeleaf object",
  },
  "th:ref": {
    "scope": "html",
    "prefix": "thref",
    "body": "th:href=\"@{$1}\"",
    "description": "Thymeleaf reference",
  },
  "th:form": {
    "scope": "html",
    "prefix": "thform",
    "body": "<form th:action=\"@{$1}\"></form>",
    "description": "Thymeleaf form",
  },
  "th:if": {
    "scope": "html",
    "prefix": "thif",
    "body": "th:if=\"\\${$1}\"",
    "description": "Thymeleaf if",
  },
  "th:switch": {
    "scope": "html",
    "prefix": "thswitch",
    "body": "th:switch=\"\\${$1}\"",
    "description": "Thymeleaf switch",
  },
  "th:case": {
    "scope": "html",
    "prefix": "thcase",
    "body": "th:case=\"$1\"",
    "description": "Thymeleaf case",
  },
  "th:value": {
    "scope": "html",
    "prefix": "thval",
    "body": "th:value=\"$1\"",
    "description": "Thymeleaf value",
  },
  "th:replace": {
    "scope": "html",
    "prefix": "threp",
    "body": "th:replace=\"$1\"",
    "description": "Thymeleaf replace",
  },
  "th:insert": {
    "scope": "html",
    "prefix": "thins",
    "body": "th:insert=\"$1\"",
    "description": "Thymeleaf insert",
  },
  "th:fragment": {
    "scope": "html",
    "prefix": "thfr",
    "body": "th:fragment=\"$1\"",
    "description": "Thymeleaf fragment",
  },
  "th:template": {
    "scope": "html",
    "prefix": "thtmpl",
    "body": [
      "<!DOCTYPE html>",
      "<html xmlns:th=\"http://www.thymeleaf.org\">",
      "\t<head>",
      "\t\t...",
      "\t</head>",
      "",
      "\t<body>",
      "\t\t...",
      "\t</body>",
      "</html>",
    ],
    "description": "Thymeleaf html template",
  },
  "th:with": {
    "scope": "html",
    "prefix": "thwth",
    "body": "th:with=\"$1\"",
    "description": "Thymeleaf with",
  },
  "th:style": {
    "scope": "html",
    "prefix": "thstyl",
    "body": "th:style=\"$1\"",
    "description": "Thymeleaf style",
  },
}
