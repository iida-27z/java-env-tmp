{
  // スペルチェッカーの設定
  "cSpell.words": [
    "CEINTL",
    "codegen",
    "dbname",
    "dearmor",
    "Dmigration",
    "ecmel",
    "EOSQL",
    "esbenp",
    "findsecbugs",
    "flywaydb",
    "gitmessage",
    "gradlew",
    "healthcheck",
    "iidadevworks",
    "initdb",
    "isready",
    "jacoco",
    "josevseb",
    "keyrings",
    "mhutchie",
    "modulith",
    "mtxr",
    "nodesource",
    "nodistro",
    "projectlombok",
    "psql",
    "Saarsoo",
    "sarif",
    "snom",
    "spotbugs",
    "springframework",
    "springsecurity",
    "sqltools",
    "temurin",
    "thymeleaf",
    "vscjava",
    "webmvc"
  ],
  "cSpell.ignorePaths": [
    ".gradle/**",
    ".vscode/thymeleaf.code-snippets",
    "build/**",
    "gradle/**",
    "gradlew",
    "gradlew.bat"
  ],

  // gitの設定
  "git.blame.statusBarItem.enabled": true,
  "git.branchProtection": ["main"],

  // HTML/CSSの設定
  "[html]": {
    "editor.quickSuggestions": {
      "other": true
    }
  },
  "css.styleSheets": ["src/main/resources/static/css/**/*.css"],

  // AI Agentの設定
  "chat.agentFilesLocations": {
    ".github/agents": true,
    ".claude/agents": true,
    "~/.copilot/agents": true,
    ".agents/agents": true
  },
  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
    ".claude/rules": true,
    "~/.copilot/instructions": true,
    "~/.claude/rules": true,
    ".agents/instructions": true
  },
  "chat.promptFilesLocations": {
    ".github/prompts": true,
    ".agents/prompts": true
  },
  "chat.agentSkillsLocations": {
    ".github/skills": true,
    ".agents/skills": true,
    ".claude/skills": true,
    "~/.copilot/skills": true,
    "~/.agents/skills": true,
    "~/.claude/skills": true
  },

  // フォーマットの設定
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.rulers": [100],
  "[java]": {
    "editor.defaultFormatter": "josevseb.google-java-format-for-vs-code",
    "editor.inlayHints.enabled": "onUnlessPressed",
    "editor.formatOnSave": false
  },
  "java.format.settings.google.version": "1.36.1",
  "[sql]": {
    "editor.defaultFormatter": "ReneSaarsoo.sql-formatter-vsc",
    "editor.formatOnSave": false
  },
  "SQL-Formatter-VSCode.dialect": "postgresql",
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "prettier.proseWrap": "preserve"
  }
}
